# Copy this file to .streamlit/secrets.toml (local) or add these keys in Streamlit Cloud secrets.

# Required for admin bootstrap
APP_ADMIN_USERNAME = "owner_admin"
APP_ADMIN_PASSWORD = "change_this_strong_password"

# Required for private signup
APP_INVITE_CODE = "share_only_with_approved_people"

# Required for persistent cloud auth (Supabase Postgres or any Postgres)
APP_DATABASE_URL = "postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional but recommended: app URL used in notifications
APP_PUBLIC_URL = "https://your-app-name.streamlit.app"

# Notification option A: webhook (Slack/Discord/custom)
APP_NOTIFY_WEBHOOK_URL = "https://example.com/webhook"

# Notification option B: SMTP email
APP_NOTIFY_EMAIL_TO = "you@example.com"
APP_NOTIFY_EMAIL_FROM = "noreply@example.com"
APP_SMTP_HOST = "smtp.example.com"
APP_SMTP_PORT = "587"
APP_SMTP_USER = "smtp_user"
APP_SMTP_PASSWORD = "smtp_password"
APP_SMTP_STARTTLS = "true"
APP_SMTP_SSL = "false"